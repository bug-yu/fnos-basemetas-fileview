# 安装向导答案文件（非交互安装用）
#
# 用法：appcenter-cli install-fpk basemetas-fileview.fpk --env config.env
# 放到工作目录，例如 /vol1/1000/docker/fileview-update/config.env
#
# 字段名必须与 fpk/basemetas-fileview/wizard/install 里的 "field" 完全一致。
# 本包安装向导只有一个字段：

# 允许预览的存储卷。
#   auto            → 自动探测所有 /volN（0.5.6 起默认，推荐）
#   /vol1,/vol2,... → 显式指定，逗号分隔
wizard_volumes=auto
