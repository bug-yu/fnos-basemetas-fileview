# ============================================================================
# fv-main.main —— 网关的**主配置**（main 上下文）
# ============================================================================
# 为什么需要这个文件（而不是直接用镜像自带的 /etc/nginx/nginx.conf）
# ---------------------------------------------------------------------------
# 因为 njs 是**动态模块**，必须用 `load_module` 加载，而
#     ★ `load_module` 的合法上下文是 **main（主配置顶层）**
#       —— 官方文档：Syntax: load_module file;  Context: main
# 所以我们自己的片段 conf.d/nginx.conf（被 http{} include）里**写不了**这行。
#
# 镜像自带的主配置里没有这一行（它只 include conf.d/*.conf），因此必须由**我们**
# 提供一份主配置，在 main 层把 njs 加载起来，再 include 我们的片段。
#
# ★ 为什么文件名是 `.main` 而不是 `.conf`
#   本文件与 conf.d/nginx.conf 一起被挂载到容器的 /etc/nginx/conf.d/ 下（bind 挂载
#   只能挂整个目录）。而**镜像自带的主配置**里有 `include /etc/nginx/conf.d/*.conf;`
#   —— 若本文件叫 `.conf`，就会被那个 include 拉进去，于是 `load_module` 又落到
#   http 上下文里、又报 "not allowed here"。
#   改成 `.main` 后缀后**不匹配 `*.conf`**，不会被镜像主配置误 include，
#   只会被我们自己的 `nginx -c` 显式指定。避免了"将来有人不带 -c 启动就崩"的隐患。
#
# ⚠️ 0.5.26 首版把 `load_module` 直接写在了 conf.d 片段里，必然报
#       nginx: [emerg] "load_module" directive is not allowed here
#    —— 注意这是「位置非法」，不是「模块文件不存在」，两者极易混淆。
#    （文件不存在会报 dlopen() failed / not binary compatible）
#    结果：即使镜像带了 njs 也一定失败，还会被启动脚本误判成"镜像不含 njs"。
#    详见 CHANGELOG「0.5.26 修订（第二轮）」。
#
# ⚠️ 关于 `load_module` 的路径怎么写（这段很重要）
#   `load_module modules/ngx_http_js_module.so;` 里那个 `modules/...` 是**相对
#   编译时 prefix** 解析的（官方镜像 prefix = /etc/nginx 时即
#   `/etc/nginx/modules/ngx_http_js_module.so`）。而 .so 真实位置因发行版而异：
#     · Debian/Ubuntu 包：/usr/lib/nginx/modules/ ，再由 /etc/nginx/modules-enabled/ 软链
#     · 官方 docker 镜像：常见 /usr/lib/nginx/modules/ 或 /etc/nginx/modules/
#   写死任一个都有赌的成分，所以**启动脚本 fv-njs-boot.sh 会先探测 .so 实际位置**，
#   把下面这行替换成找到的绝对路径，再拿去 -t / 启动。
#   这里的默认值只是"探测失败时的兜底"，正常情况下会被脚本覆盖。
# ============================================================================

load_module modules/ngx_http_js_module.so;

worker_processes auto;

# 日志走容器标准输出/错误，便于 `docker logs`
error_log /dev/stderr warn;
pid /tmp/fv-nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /dev/stdout;

    # 真正的业务配置在 conf.d/nginx.conf（http 上下文片段）
    include /etc/nginx/conf.d/*.conf;
}

