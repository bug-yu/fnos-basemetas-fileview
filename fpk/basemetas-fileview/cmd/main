#!/bin/bash
# 应用运行控制脚本
#
# ★★ 实测事实（0.5.30，见 SECURITY.md §4 待办 5）：**框架启停 docker 应用时不调用本脚本**，
#    而是自己按 config/resource 里的 docker-project 资源走 compose。
#    证据：`appcenter-cli stop` + `start`（提示 Launching complete）之后，
#    ${TRIM_PKGVAR}/fv-volumes.log **一条新记录都没有** —— 而本脚本的 start 分支一旦执行
#    必然写日志（无条件同步挂载段 + 跑预检）。
#
#    ⇒ 下面 start 分支里的几件事，在「应用启停」这个时机**不会**发生，只在有人显式调用
#      本脚本时才执行。框架真正会调用的只有 **status**（会被轮询）。
#      「启动时自愈 / 启动时预检」这个时机目前是没有覆盖的：自愈实际发生在
#      **升级**（cmd/upgrade_callback）与**保存设置**（cmd/config_callback）两个时机。
#
# 本脚本做什么：
#   1. start  —— 安装完整性预检 + 同步存储卷挂载段 + 开放 API 预检（⚠️ 见上：框架启停走不到）
#   2. stop   —— **故意什么都不做**（只记一行诊断），启停交给框架自己的 compose
#   3. status —— 如实回报容器状态（这个是框架真的会调的）

ENGINE="basemetas-fileview-engine"
GATEWAY="basemetas-fileview-gateway"

COMPOSE="${TRIM_APPDEST}/docker/docker-compose.yaml"
NGINXCONF="${TRIM_APPDEST}/docker/nginx.conf"

is_running() {
  docker inspect "$1" 2>/dev/null | grep -q '"Status": "running"'
}

# 安装完整性检查：安装包内的 app.tgz 若未释放到 ${TRIM_APPDEST}，docker 会因 bind 挂载源
# 不存在而报 "not a directory: ..."，看不出真正原因。这里提前判断并给出人话提示。
files_ok() {
  [ -n "$TRIM_APPDEST" ] && [ -f "$COMPOSE" ] && [ -f "$NGINXCONF" ]
}

report_incomplete() {
  {
    echo "应用文件不完整，无法启动。"
    echo "缺少：${TRIM_APPDEST}/docker/docker-compose.yaml 或 docker/nginx.conf"
    echo "原因通常是安装未完成（安装包里的 app.tgz 没有被释放到应用目录），而不是配置错误。"
    echo "请卸载本应用后重新安装。排查命令： ls -la ${TRIM_APPDEST}/docker/"
  } > "$TRIM_TEMP_LOGFILE" 2>/dev/null
}

case "$1" in
  start)
    if ! files_ok; then
      report_incomplete
      exit 1
    fi
    # 清掉可能残留的 app.sock：它落在 ${TRIM_APPDEST} 这个宿主机目录里，容器删了文件还在；
    # nginx 不会自己清理已存在的 unix socket，下次启动会 bind() failed (98) 并陷入重启循环。
    # compose 的启动命令里也清了一次，这里是双保险。
    rm -f "${TRIM_APPDEST}/app.sock" 2>/dev/null

    # 同步存储卷挂载段（幂等；顺带补生成 docker/.env）。
    # 升级时框架会把新的 app.tgz 重新释放到 ${TRIM_APPDEST}，docker-compose.yaml 被覆盖回
    # 模板里写死的挂载段，之前按设置写好的卷就此丢失。
    # ⚠️ 这里**不是**升级自愈的落点 —— 框架启停不调用本脚本（见文件头），所以「框架起容器前
    #    先跑到这一段」是不成立的。真正承担升级自愈的是 cmd/upgrade_callback（同样跑
    #    fv_sync_volumes），保存设置时则由 cmd/config_callback 跑。
    #    这一段留着，只是「有人显式调用 cmd/main start 时」的兜底，别当成启动时必然发生的事。
    if [ -r "${TRIM_APPDEST}/docker/fv-volumes.sh" ]; then
      . "${TRIM_APPDEST}/docker/fv-volumes.sh"
      fv_prepare_dirs
      fv_sync_volumes "" ensure >/dev/null
    fi

    # 飞牛开放 API 预检（只读，不改任何东西）：确认「按用户校验文件权限」这条路能不能
    # 走通 —— 需要 token、API socket、已授权目录三件事。结果写进 ${TRIM_PKGVAR}/fv-volumes.log。
    # 全程不阻塞：任何失败都只是写日志。详见 app/docker/fv-acl-probe.sh 头部注释。
    # ⚠️ 同 config_callback 里的那次调用：本分支框架走不到，所以**实际会跑到的只有「保存设置」**。
    if [ -r "${TRIM_APPDEST}/docker/fv-acl-probe.sh" ]; then
      . "${TRIM_APPDEST}/docker/fv-acl-probe.sh"
      fv_acl_probe "main start"
    fi

    # 兜底再建一次宿主侧挂载目录（fonts / data / logs）—— 上面 source 不到公共库时也要有。
    # 权限 0700：引擎容器实测以 root 运行（uid=0），root 无视权限位，收紧不影响读写。
    if [ -n "${TRIM_PKGVAR:-}" ]; then
      mkdir -p "$TRIM_PKGVAR/fonts" "$TRIM_PKGVAR/data" "$TRIM_PKGVAR/logs" 2>/dev/null
      chmod 0700 "$TRIM_PKGVAR/fonts" "$TRIM_PKGVAR/data" "$TRIM_PKGVAR/logs" 2>/dev/null
    else
      {
        echo "提示：环境变量 TRIM_PKGVAR 为空，自定义字体 / 引擎工作目录可能未按预期挂载。"
        echo "本应用不影响使用（容器内置免费思源字体）；若要装商用字体请检查该变量。"
      } > "$TRIM_TEMP_LOGFILE" 2>/dev/null
    fi
    exit 0
    ;;

  stop)
    # ⚠️ 这里**故意什么都不做**，只记一行诊断日志。
    # 启停动作交给框架自己的 docker compose —— 抢在它前面停容器会让两边状态对不上；
    # 而 docker stop -t 5 对 Java + redis + rocketmq 这套栈太短，被 SIGKILL 后退出码变成
    # 137，界面会显示「容器错误退出(137)」。不加干预时容器本来就能正常停下。
    if [ -r "${TRIM_APPDEST}/docker/fv-volumes.sh" ]; then
      . "${TRIM_APPDEST}/docker/fv-volumes.sh"
      fv_log "── cmd/main stop 被调用（本脚本不停容器，交给框架）──"
      fv_log "   调用时容器：$(docker ps -a --filter name=basemetas-fileview \
            --format '{{.Names}}={{.State}}' 2>/dev/null | tr '\n' ' ')"
    fi
    exit 0
    ;;

  status)
    if ! files_ok; then
      exit 3
    fi
    if is_running "$ENGINE" && is_running "$GATEWAY"; then
      exit 0
    fi
    exit 3
    ;;

  *)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
