#!/bin/bash
# 升级后：把挂载段重新写一遍，并重建容器。
#
# ⚠️ 必须做：升级时框架会把新的 app.tgz 重新释放到 ${TRIM_APPDEST}，
# docker-compose.yaml 因此被**覆盖回安装包里的模板内容**（挂载段是写死的 /vol1、/vol2），
# 此前按设置写好的卷会被顶掉；框架紧接着就用这份 compose 重建容器。
#
# 取值优先级：升级向导变量（本包没有 wizard/upgrade，通常为空）
#            → 上次保存的设置（${TRIM_PKGVAR}/volumes.conf）
#            → auto

LIB="${TRIM_APPDEST}/docker/fv-volumes.sh"
[ -r "$LIB" ] || exit 0
. "$LIB"

fv_prepare_fonts
# rebuild：升级一定会换 compose，无条件重建容器最省事也最稳。
fv_sync_volumes "${wizard_volumes:-}" rebuild >/dev/null

exit 0
