#!/bin/bash
# 与 install_callback 逻辑一致：在应用设置里改存储卷后同样重建挂载段。

COMPOSE="${TRIM_APPDEST}/docker/docker-compose.yaml"
VOLUMES="${wizard_volumes:-/vol1,/vol2}"

[ -f "$COMPOSE" ] || exit 0

BLOCK=""
OLD_IFS="$IFS"
IFS=','
for v in $VOLUMES; do
  v="$(echo "$v" | tr -d '[:space:]')"
  case "$v" in
    /vol*|\/volume*) ;;
    *) continue ;;
  esac
  case "$v" in
    *:*) continue ;;
  esac
  BLOCK="${BLOCK}      - ${v}:${v}:ro
"
done
IFS="$OLD_IFS"

[ -n "$BLOCK" ] || exit 0

TMP="${COMPOSE}.new"
if awk -v block="$BLOCK" '
  /## VOLUMES_BEGIN/ { print; printf "%s", block; skip=1; next }
  /## VOLUMES_END/   { skip=0 }
  skip != 1 { print }
' "$COMPOSE" > "$TMP" 2>/dev/null && [ -s "$TMP" ]; then
  mv "$TMP" "$COMPOSE"
fi

# 建好自定义字体目录（compose 里已把 ${TRIM_PKGVAR}/fonts 挂到容器 /usr/local/share/fonts）
if [ -n "${TRIM_PKGVAR:-}" ]; then
  mkdir -p "$TRIM_PKGVAR/fonts" 2>/dev/null
fi

exit 0
