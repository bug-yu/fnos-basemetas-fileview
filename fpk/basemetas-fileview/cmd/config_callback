#!/bin/bash
# 在应用「设置」里改存储卷后：重建挂载段 + 重建容器。
#
# ⚠️ 第二步是重点：bind 挂载不会在运行中的容器里生效（docker restart 也不行），
#    而飞牛框架保存设置后不会重建容器，必须自己做。

# ⚠️ 公共库必须放在 docker/ 目录下（fnpack 只收 docker/、ui/、config/），见 install_callback。
LIB="${TRIM_APPDEST}/docker/fv-volumes.sh"
[ -r "$LIB" ] || exit 0
. "$LIB"

fv_prepare_dirs
# ensure：只在挂载清单**真的变了**才重建容器（双向比对：少了要重建，多了也要重建）。
# 不要无条件 rebuild —— 重建期间容器会短暂以 <hash>_<name> 的临时名存在，
# 若此刻飞牛正在停用 / 卸载，它手里的容器 ID 就失效了，界面会报 Request failed。
fv_sync_volumes "${wizard_volumes:-}" ensure >/dev/null

# 顺带跑一次开放 API 预检（只读，不阻塞、不报错）。
# 挂在「保存设置」上，是因为**框架启停应用时不调用 cmd/main**（0.5.30 实测，见
# cmd/main 文件头与 SECURITY.md §4 待办 5）—— 于是「保存设置」成了预检**唯一**会自动
# 执行的时机。（cmd/main start 里也有同样的调用，但那个分支框架走不到。）
# ⚠️ 别再写成「cmd/main start 只在停止→启动时才被调用，而应用很少停」——
#    那是 0.5.30 之前的猜测，已被实测否定。
if [ -r "${TRIM_APPDEST}/docker/fv-acl-probe.sh" ]; then
  . "${TRIM_APPDEST}/docker/fv-acl-probe.sh"
  fv_acl_probe "config_callback（保存设置）"
fi

exit 0
