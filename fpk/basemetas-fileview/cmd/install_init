#!/bin/bash
# 安装开始前：先把宿主侧的挂载目录建好。
#
# 为什么必须在**这一步**做：compose 里有三个 bind 挂载指向 ${TRIM_PKGVAR}
#   fonts → /usr/local/share/fonts
#   data  → /opt/fileview/data   （引擎的转换产物 / 临时文件 / LibreOffice、CAD 工作目录）
#   logs  → /opt/fileview/logs
# 如果宿主上这些目录还不存在，docker 会**以 root 身份**把它们建出来（0755）。
# 万一容器里的进程不是 root，就写不进去 —— 表现为预览失败，而日志里看不出原因。
# 框架会在 install_callback 之前就用 compose 把容器建好，所以这里先把目录备好。
#
# 不 source 公共库：这个时机安装包可能还没释放到 ${TRIM_APPDEST}，库读不到。
# 权限 0700：引擎容器实测以 root 运行（docker exec ... id → uid=0(root)），root 无视
# 权限位，所以给 0700 不影响引擎读写；同时挡住本地其它非 root 用户。
if [ -n "${TRIM_PKGVAR:-}" ]; then
  mkdir -p "$TRIM_PKGVAR/fonts" "$TRIM_PKGVAR/data" "$TRIM_PKGVAR/logs" 2>/dev/null
  chmod 0700 "$TRIM_PKGVAR/fonts" "$TRIM_PKGVAR/data" "$TRIM_PKGVAR/logs" 2>/dev/null
fi
exit 0
