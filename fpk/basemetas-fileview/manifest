changelog=0.5.25：安全收紧 —— 逐用户权限闸门不再因 URI 后缀是 .css/.png 等就直接放行（原先「/preview/api/file.css?filePath=/vol1/私密.docx」可绕过判定）；引擎镜像锁到 digest 防上游改内容；data/logs/fonts 目录权限由 0777 收到 0700（引擎实测以 root 运行，不受影响）；删掉未使用的 api-scope 声明。0.5.24：Excel / CSV 预览恢复缩放控件 —— 上游把 Luckysheet 的统计栏整条隐藏了，而缩放滑杆就在统计栏里（现在只把「缩放」这一项放出来，求和/视图仍隐藏）。0.5.23：修复带触摸的电脑上 PDF 预览没有工具栏的问题。0.5.22：按官方部署指南补齐两处生产必做项（挂出引擎工作目录与日志、关掉网络文件预览）。0.5.21：修复卸载容错脚本的 CRLF 行尾。0.5.20：放开单文件预览大小上限，默认 1 GB。

ctl_stop=true
checkport=false

# 隐藏应用设置里的「访问权限」标签页。
# 那个页面是给「让用户自己选授权目录」的应用用的（对应开放 API 的 trim.file.sharedAccess），
# 本应用不走那套 —— 可访问的存储卷由安装向导的 wizard_volumes 决定，逐用户权限由闸门按 ACL 判定，
# 所以那一栏永远是「暂无授权记录」，留着只会让人以为哪里没配好。
disable_authorization_path=true
